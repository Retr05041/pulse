<UserControl x:Class="Pulse.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext (set automatically by the App.xaml DataTemplate) is a LoginViewModel,
         so {Binding X} reads/writes LoginViewModel.X. -->
    <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28"
            Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <TextBlock Text="P.U.L.S.E." Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="Agent Login" Style="{StaticResource H1}" Margin="0,4,0,18"/>

            <TextBlock Text="Saved agents" Style="{StaticResource Small}"/>
            <ComboBox ItemsSource="{Binding SavedAgents}" SelectedItem="{Binding SelectedAgent}" Margin="0,4,0,14"/>

            <TextBlock Text="Agent token" Style="{StaticResource Small}"/>
            <!-- PasswordBox.Password can't be bound (deliberate WPF security choice), so the
                 code-behind forwards it to the view model. -->
            <PasswordBox x:Name="TokenBox" Margin="0,4,0,10" Padding="6"
                         PasswordChanged="TokenBox_PasswordChanged"/>

            <CheckBox Content="Remember on this PC (encrypted)" IsChecked="{Binding RememberToken}"
                      Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>

            <Button Content="Connect" Command="{Binding ConnectCommand}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" Margin="0,14,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
