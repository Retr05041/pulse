<UserControl x:Class="Pulse.Views.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: agent info on the left, actions on the right -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <Button Content="Logout" Command="{Binding LogoutCommand}" Background="{StaticResource Line}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="FLEET STATUS" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="{Binding AgentSymbol}" Style="{StaticResource H1}" FontSize="25" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding CreditsText}" Style="{StaticResource Small}"/>
            </StackPanel>
        </DockPanel>

        <!-- Fleet: ItemsControl stamps out one ItemTemplate per ship in Ships, laid out by a WrapPanel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <ItemsControl ItemsSource="{Binding Ships}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- DataContext here is ONE ShipViewModel -->
                        <Border Width="260" Margin="6" Padding="14" CornerRadius="10"
                                Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border DockPanel.Dock="Right" Background="#0F766E" CornerRadius="10" Padding="8,3">
                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Symbol}" Foreground="{StaticResource Text}" FontSize="16" FontWeight="Bold"/>
                                </DockPanel>

                                <TextBlock Text="LOCATION" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Location}" Foreground="#CBD5E1" FontSize="11" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding EtaText}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,2,0,10"/>

                                <TextBlock Text="FUEL" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                                <Grid Margin="0,2,0,8">
                                    <ProgressBar Height="13" Maximum="100" Value="{Binding FuelPercent, Mode=OneWay}"
                                                 Foreground="{StaticResource Accent}" Background="{StaticResource Bg}"/>
                                    <TextBlock Text="{Binding FuelText}" Foreground="White" FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="CARGO" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                                <Grid Margin="0,2,0,0">
                                    <ProgressBar Height="13" Maximum="100" Value="{Binding CargoPercent, Mode=OneWay}"
                                                 Foreground="#A78BFA" Background="{StaticResource Bg}"/>
                                    <TextBlock Text="{Binding CargoText}" Foreground="White" FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
